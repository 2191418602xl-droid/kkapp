# Server-only secret. Never use NEXT_PUBLIC_ or VITE_ prefixes.
DEEPSEEK_API_KEY=

# Server-only Volcengine image generation. Set BOTH values after model activation.
# Model example: doubao-seedream-5-0-pro-260628 (verify console availability).
ARK_API_KEY=
ARK_IMAGE_MODEL=doubao-seedream-5-0-pro-260628

# Server-only Doubao Speech NEW console API Key; not the Ark key.
# TTS 2.0 system voices only. Example speaker: zh_female_vv_uranus_bigtts
DOUBAO_SPEECH_API_KEY=
DOUBAO_TTS_SPEAKER=zh_female_vv_uranus_bigtts
DOUBAO_TTS_VOICE_LABEL=豆包女声 Vivid

# Legacy provider / speech recognition. Volcengine image and TTS config take priority.
SILICONFLOW_API_KEY=
SILICONFLOW_IMAGE_MODEL=Kwai-Kolors/Kolors
SILICONFLOW_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
SILICONFLOW_ASR_MODEL=TeleAI/TeleSpeechASR

# Local-only E2E environment (never enable on a hosted runtime)
E2E_TEST_MODE=0
